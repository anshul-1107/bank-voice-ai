      "webhookId": "9b12c8a4-4f27-4a0b-bf3e-91d182e01234"
    },
    {
      "parameters": {
        "jsCode": "// Fetch pending EMI customers or use incoming payload\nconst incoming = $input.all();\n\nif (incoming.length > 0 && incoming[0].json && incoming[0].json.phone) {\n  return incoming;\n}\n\n// Default Banking Leads for EMI outreach\nreturn [\n  {\n    json: {\n      customer_id: \"C001\",\n      name: \"Anshul Mathur\",\n      phone: \"+919636274630\",\n      email: \"anshul.mathur@example.com\",\n      loan_product: \"Home Loan\",\n      account_no: \"LN-HL-9011\",\n      emi_amount: 32500,\n      due_date: \"2026-10-15\",\n      do_not_call: false,\n      preferred_language: \"hi-IN\"\n    }\n  },\n  {\n    json: {\n      customer_id: \"C002\",\n      name: \"Ditya Saini\",\n      phone: \"+918209641146\",\n      email: \"ditya.saini@example.com\",\n      loan_product: \"Auto Loan\",\n      account_no: \"LN-AL-4482\",\n      emi_amount: 14800,\n      due_date: \"2026-10-12\",\n      do_not_call: false,\n      preferred_language: \"hi-IN\"\n    }\n  },\n  {\n    json: {\n      customer_id: \"C003\",\n      name: \"Rahul Sharma\",\n      phone: \"+919876543210\",\n      email: \"rahul.sharma@example.com\",\n      loan_product: \"Personal Loan\",\n      account_no: \"LN-PL-1102\",\n      emi_amount: 8900,\n      due_date: \"2026-10-10\",\n      do_not_call: false,\n      preferred_language: \"en-IN\"\n    }\n  }\n];"
      },
      "id": "b2c3d4e5-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "Load EMI Customer Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        420
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.do_not_call }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c3d4e5f6-7a8b-4c9d-0e1f-2a3b4c5d6e7f",
      "name": "DNC & Compliance Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/webcall/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"phone\": \"{{ $json.phone }}\",\n  \"direction\": \"outbound\",\n  \"customer_id\": \"{{ $json.customer_id }}\",\n  \"purpose\": \"emi_reminder\"\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "d4e5f6a7-8b9c-4d0e-1f2a-3b4c5d6e7f8a",
      "name": "Trigger Bank Voice Agent (Priya)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// Simulate AI conversation turn and post-call analysis\nconst callData = $input.first().json;\nconst customer = $('Load EMI Customer Queue').first().json;\n\n// Sample simulated outcome based on Bank Voice Agent rules\nconst outcome = {\n  call_id: callData.call_id || (\"CALL-\" + Date.now()),\n  customer_id: customer.customer_id,\n  customer_name: customer.name,\n  phone: customer.phone,\n  emi_amount: customer.emi_amount,\n  status: \"COMPLETED\",\n  customer_intent: \"PROMISE_TO_PAY\",\n  payment_commitment_date: \"2026-10-12\",\n  transcript: \"Priya: Namaste Anshul ji, main Neural Finance se Priya bol rahi hoon. Aapka Rs. 32,500 ka Home Loan EMI due hai. Customer: Haan ji main Monday ko pay kar dunga. Priya: Dhanyawad ji, note kar liya hai.\",\n  qa_score: 95,\n  qa_verdict: \"PASS\",\n  guardrail_violations: 0\n};\n\nreturn [{ json: outcome }];"
      },
      "id": "e5f6a7b8-9c0d-4e1f-2a3b-4c5d6e7f8a9b",
      "name": "QA Scorer & Call Ledger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond_qa",
              "leftValue": "={{ $json.qa_verdict }}",
              "rightValue": "PASS",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "f6a7b8c9-0d1e-4f2a-3b4c-5d6e7f8a9b0c",
