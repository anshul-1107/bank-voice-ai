# --- Live agent LLM (any OpenAI-compatible endpoint) ---
LLM__BASE_URL=https://api.groq.com/openai/v1
LLM__API_KEY=
LLM__MODEL=openai/gpt-oss-120b

# --- QA judge (use a stronger model than the live agent; different provider is fine) ---
JUDGE__BASE_URL=https://api.openai.com/v1
JUDGE__API_KEY=
JUDGE__MODEL=gpt-4.1

# --- Sarvam AI (STT Saaras + TTS Bulbul) ---
SARVAM__API_KEY=
SARVAM__TTS_SPEAKER=anushka

# --- Telephony: exotel | plivo ---
TELEPHONY__PROVIDER=exotel
TELEPHONY__PUBLIC_BASE_URL=https://voice.yourbank.example
TELEPHONY__EXOTEL_SID=
TELEPHONY__EXOTEL_API_KEY=
TELEPHONY__EXOTEL_API_TOKEN=
TELEPHONY__EXOTEL_CALLER_ID=          # must be your 1600-series number (TRAI, BFSI)
TELEPHONY__EXOTEL_VOICEBOT_APP_ID=
TELEPHONY__PLIVO_AUTH_ID=
TELEPHONY__PLIVO_AUTH_TOKEN=
TELEPHONY__PLIVO_CALLER_ID=

# --- Providers: set to mock to run fully offline ---
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
LLM_PROVIDER=openai_compatible

BANK_NAME=Neural Finance
GRIEVANCE_OFFICER=Ms. Anita Rao, grievance@neuralfinance.example, 1800-000-0000
QA__DB_PATH=data/qa.sqlite3
